{
  // WeatherDaddy on Cloudflare Workers with static assets.
  //
  // The site used to be a Pages project in "advanced mode" (a root
  // _worker.js in front of the asset bundle). Pages has no Cron
  // Triggers, and the push-notification work needs a scheduled handler,
  // so the same code now deploys as a Worker. The site itself lives in
  // public/ (everything Pages used to serve from the repo root); the
  // Worker source, tooling and config stay outside the asset bundle.
  "name": "weatherdaddy",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only these paths hit the Worker before the asset router: the OWM
    // proxy (not an asset at all) and the three files whose Cache-Control
    // the Worker rewrites so a deploy actually reaches installed PWAs
    // (see serveAsset in worker/index.js). Everything else is served
    // straight from the edge without a Worker invocation.
    "run_worker_first": ["/api/*", "/sw.js", "/", "/index.html"]
  },
  // Public half of the VAPID keypair; the private half is the secret
  // VAPID_PRIVATE_KEY (`wrangler secret put`; .dev.vars locally). The
  // subject is what push services see as the sender's contact.
  "vars": {
    "VAPID_PUBLIC_KEY": "BLC01tz2OD37G9QKzqqpv9cVpHoswWSYkc8kGUNbSjgLZb-uwx9i0FrCj3BJD_t6aDWudnk6YO8CsEcRRJ44ZM4",
    "VAPID_SUBJECT": "https://weatherdaddy.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weatherdaddy-db",
      "database_id": "5353df81-4ea1-40ec-a047-cd1a4e642941",
      "migrations_dir": "migrations"
    }
  ],
  // Clock-driven notifications (briefing, thresholds, full moon) are due
  // on the hour in each subscriber's own timezone; running twice an
  // hour gives a retry within the hour and lands half-hour zones
  // (Newfoundland, India) at :30 rather than :60. Severe-weather alerts
  // get their own five-minute cron: a tornado warning lasts 30-45
  // minutes. The rain nowcast also runs every five minutes, on the
  // minutes in between, so each check is its own invocation with its
  // own subrequest and CPU budget (the Free plan allows five crons per
  // account). worker/push.js dispatches on the cron string, so these
  // must match CRON_CLOCK / CRON_ALERTS / CRON_NOWCAST there.
  "triggers": { "crons": ["*/30 * * * *", "*/5 * * * *", "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"] },
  "observability": { "enabled": true },
  // Production hostname. This moved from the Pages project on cutover;
  // a hostname can belong to only one of the two at a time.
  "routes": [{ "pattern": "weatherdaddy.app", "custom_domain": true }]
}
